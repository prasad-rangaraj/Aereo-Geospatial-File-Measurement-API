# Application Settings
PROJECT_NAME="Aereo Geospatial File Measurement API"
API_V1_STR="/api"
DEBUG=False

# Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50

# Database
DATABASE_URL="sqlite:///./geospatial_measurements.db"

# GIS Settings
DEFAULT_FALLBACK_CRS="EPSG:4326"
ENFORCE_CRS_VALIDATION=True
